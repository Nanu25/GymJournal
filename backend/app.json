{
  "name": "Gym Journal",
  "description": "A fitness tracking application",
  "repository": "https://github.com/yourusername/gym-journal",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "NODE_ENV": {
      "description": "Environment for the application",
      "value": "production"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL database URL",
      "required": true
    },
    "JWT_SECRET": {
      "description": "Secret key for JWT tokens",
      "required": true
    },
    "GEMINI_API_KEY": {
      "description": "Google Gemini API key for AI chat",
      "required": false
    },
    "GOOGLE_CLIENT_ID": {
      "description": "Google OAuth Client ID for authentication",
      "required": false
    },
    "VITE_GOOGLE_CLIENT_ID": {
      "description": "Google OAuth Client ID for frontend (Vite build-time variable)",
      "required": false
    }
  },
  "scripts": {
    "postdeploy": "node dist/scripts/ensureUploadsDir.js"
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
} 